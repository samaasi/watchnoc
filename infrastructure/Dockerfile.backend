# Stage 1: Build the backend
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Install dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build statically linked binary
# Using CGO_ENABLED=0 to ensure it can run on scratch/alpine
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o server.exe ./cmd/server

# Stage 2: Minimal runner image
FROM alpine:latest
WORKDIR /app

# Add CA certificates for external API calls
RUN apk --no-cache add ca-certificates

# Copy binary from builder
COPY --from=builder /app/server.exe /app/server.exe

# Ensure it's executable
RUN chmod +x /app/server.exe

# Expose standard port
EXPOSE 8080

CMD ["/app/server.exe"]
