# Backend
DATABASE_URL=postgres://username:password@localhost:5432/watchnoc?sslmode=disable
REDIS_URL=redis://localhost:6379/0
CLERK_SECRET_KEY=sk_live_...

# Frontend
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...

# Deployment (set as GitHub repository secrets)
# SERVER_IP=your.vps.ip.address
# SERVER_USER=deploy
# SSH_PRIVATE_KEY=<contents of private key>
# GITHUB_TOKEN is set automatically by GitHub Actions

# For docker-compose on the VPS
GITHUB_REPOSITORY_OWNER=your-github-username-or-org
