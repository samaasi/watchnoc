# Backend - Core Services
DATABASE_URL=postgres://username:password@localhost:5432/watchnoc?sslmode=disable
REDIS_URL=redis://localhost:6379/0
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLIC_KEY=pk_live_...

# Frontend
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...

# GitHub Integration
GITHUB_APP_ID=1234567
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
GITHUB_CLIENT_ID=Iv1.abc123def456
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEBHOOK_BASE_URL=https://your-domain.com

# Trello Integration
TRELLO_API_KEY=your-trello-api-key
TRELLO_API_SECRET=your-trello-api-secret
TRELLO_OAUTH_CALLBACK_URL=https://your-domain.com/trello/callback
TRELLO_WEBHOOK_CALLBACK_URL=https://your-domain.com/trello/webhook
TRELLO_API_BASE_URL=https://api.trello.com/1

# Jira Integration
JIRA_CLIENT_ID=your-jira-client-id
JIRA_CLIENT_SECRET=your-jira-client-secret
JIRA_WEBHOOK_SECRET=your-jira-webhook-secret
JIRA_OAUTH_BASE_URL=https://auth.atlassian.com
JIRA_API_BASE_URL=https://api.atlassian.com
JIRA_CALLBACK_URL=https://your-domain.com/jira/callback
JIRA_TICKET_KEY_PATTERN=[A-Z][A-Z0-9]+-\d+

# GitLab Integration
GITLAB_CLIENT_ID=your-gitlab-client-id
GITLAB_CLIENT_SECRET=your-gitlab-client-secret
GITLAB_WEBHOOK_SECRET=your-gitlab-webhook-secret
GITLAB_OAUTH_BASE_URL=https://gitlab.com
GITLAB_API_BASE_URL=https://gitlab.com/api/v4
GITLAB_CALLBACK_URL=https://your-domain.com/gitlab/callback

# Linear Integration
LINEAR_CLIENT_ID=your-linear-client-id
LINEAR_CLIENT_SECRET=your-linear-client-secret
LINEAR_WEBHOOK_SECRET=your-linear-webhook-secret
LINEAR_OAUTH_BASE_URL=https://linear.app
LINEAR_API_BASE_URL=https://api.linear.app/graphql
LINEAR_CALLBACK_URL=https://your-domain.com/linear/callback

# Slack Integration
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_OAUTH_BASE_URL=https://slack.com
SLACK_API_BASE_URL=https://slack.com/api
SLACK_CALLBACK_URL=https://your-domain.com/slack/callback

# PagerDuty Integration
PAGERDUTY_WEBHOOK_SECRET=your-pagerduty-webhook-secret
PAGERDUTY_API_BASE_URL=https://api.pagerduty.com

# Deployment (set as GitHub repository secrets)
# SERVER_IP=your.vps.ip.address
# SERVER_USER=deploy
# SSH_PRIVATE_KEY=<contents of private key>
# GITHUB_TOKEN is set automatically by GitHub Actions

# For docker-compose on the VPS
GITHUB_REPOSITORY_OWNER=your-github-username-or-org
